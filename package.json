{
  "name": "go-lanka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "node tests/integration/rls-smoke.mjs",
    "db:migrate": "node --env-file=.env.local node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m db/migrations -d MIGRATION_DATABASE_URL",
    "db:rollback": "node --env-file=.env.local node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m db/migrations -d MIGRATION_DATABASE_URL",
    "db:create": "node-pg-migrate create -m db/migrations --migration-file-language sql",
    "db:seed": "node scripts/run-sql.mjs db/seed.sql",
    "create-admin": "tsx scripts/create-admin.ts",
    "invite:admin": "tsx scripts/resend-admin-invite.ts",
    "rates:refresh": "node scripts/refresh-rates.mjs",
    "setup:local": "node scripts/generate-local-setup.mjs",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.2",
    "@node-rs/argon2": "2.2.2",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.2",
    "file-type": "22.3.0",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "otplib": "13.6.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "resend": "6.37.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
