# Production environment template. Copy to .env.production and replace placeholders.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_ALLOW_INDEXING=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Runtime roles. The app must never use the migration role.
PUBLIC_DATABASE_URL=postgresql://golanka_public:CHANGE_ME@localhost:5432/golanka_prod
AUTH_DATABASE_URL=postgresql://golanka_auth:CHANGE_ME@localhost:5432/golanka_prod
ADMIN_DATABASE_URL=postgresql://golanka_admin:CHANGE_ME@localhost:5432/golanka_prod

IP_HASH_SECRET=
MFA_ENCRYPTION_KEY=
CRON_SECRET=
TRUST_PROXY=cloudflare

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/LKR

STORAGE_ROOT=/var/lib/golanka/media
LOG_LEVEL=info
