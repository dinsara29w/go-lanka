# Site
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Development can use Cloudflare's test keys:
# site key: 1x00000000000000000000AA
# secret:   1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Keep false until the production domain and content are launch-ready.
NEXT_PUBLIC_ALLOW_INDEXING=false

# PostgreSQL runtime roles. Never use the migration role at runtime.
PUBLIC_DATABASE_URL=postgresql://golanka_public:change-me@localhost:5432/go_lanka_dev
AUTH_DATABASE_URL=postgresql://golanka_auth:change-me@localhost:5432/go_lanka_dev
ADMIN_DATABASE_URL=postgresql://golanka_admin:change-me@localhost:5432/go_lanka_dev

# Used only by migration/seed scripts. Do not expose this to the running app.
MIGRATION_DATABASE_URL=postgresql://golanka_migrator:change-me@localhost:5432/go_lanka_dev

# 32-byte random values. Generate with a CSPRNG.
IP_HASH_SECRET=
# Base64-encoded 32-byte key for AES-256-GCM encryption of TOTP secrets.
MFA_ENCRYPTION_KEY=
CRON_SECRET=

# none | cloudflare | caddy
TRUST_PROXY=none

# External services
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Meta WhatsApp Cloud API. Required for automated admin/customer messages.
# Outbound messages outside a 24-hour customer service window need approved
# templates; set the template names below to use them.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_ADMIN_TEMPLATE=
WHATSAPP_CUSTOMER_TEMPLATE=

EXCHANGE_RATE_API_KEY=
# Default free provider used when EXCHANGE_RATE_API_URL is unset.
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/LKR

# Local filesystem storage
STORAGE_ROOT=./.data/media
LOG_LEVEL=info
